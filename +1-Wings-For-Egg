CreateToggle("Steal Best Eggs", function(state)
    _G.Steal = state
    print("Steal: ", state)
    if state then
        task.spawn(function()
            while _G.Steal do
                task.wait()
                pcall(function()
                    local BestFriend
                    local MaxScale = -math.huge
                    for _, friend in pairs(Workspace.Live.Friends:GetChildren()) do
                        local SpawnScale = friend:GetAttribute("SpawnScale")
                        if SpawnScale and MaxScale < SpawnScale then
                            MaxScale = SpawnScale
                            BestFriend = friend
                        end
                    end
                    if BestFriend and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        LocalPlayer.Character.HumanoidRootPart.CFrame = BestFriend.RootPart.CFrame
                        task.wait(0.2)
                        fireproximityprompt(BestFriend.RootPart.StealPromptAttach.StealPrompt)
                        task.wait(0.2)
                        if OwnerPlot and OwnerPlot:FindFirstChild("TouristPart") then
                            LocalPlayer.Character.HumanoidRootPart.CFrame = OwnerPlot.TouristPart.CFrame
                        end
                    end
                    task.wait(0.2)
                end)
            end
        end)
    end
end)

