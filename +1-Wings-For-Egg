CreateToggle("Auto Place", function(state)
    _G.Place = state
    print("Place: ", state)
    if state then
        task.spawn(function()
            while _G.Place do
                task.wait()
                pcall(function()
                    local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
                    local ToolToPlace
                    for _, item in pairs(Character:GetChildren()) do
                        if item:IsA("Tool") and item:GetAttribute("friendUID") then
                            ToolToPlace = item
                            break
                        end
                    end
                    if not ToolToPlace then
                        for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
                            if item:IsA("Tool") and item:GetAttribute("friendUID") then
                                ToolToPlace = item
                                break
                            end
                        end
                    end
                    if ToolToPlace then
                        local Arguments = {
                            [1] = ToolToPlace:GetAttribute("friendUID"),
                            [2] = 0,
                            [3] = 0
                        }
                        ReplicatedStorage.SharedModules.Network.Remotes:FindFirstChild("Place Friend"):FireServer(unpack(Arguments))
                    end
                    task.wait(0.2)
                end)
            end
        end)
    end
end)

